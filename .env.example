POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=postgres
XM_ADMIN_EMAIL=admin@autoaudit.id
XM_ADMIN_PASSWORD=change-this-admin-password
XM_COOKIE_SECURE=0

# Retain integration PDFs for workflow download/retry; both API and worker share /data.
XM_INTEGRATION_EXPORT_DAYS=7

# Optional: lets the platform administrator run this deploy script from the dashboard (pm2 servers only).
# XM_DEPLOY_SCRIPT=/var/www/html/xm-agent/deploy.sh

# Optional internal API key: xm_internal_ prefix; configure on VPS API service.
XM_INTERNAL_API_KEY=
